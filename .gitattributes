# Normalize line endings to LF in the repository and in the working tree on
# every platform, so Biome formatting and CI output match on Windows and Linux.
* text=auto eol=lf

# Binary assets are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
