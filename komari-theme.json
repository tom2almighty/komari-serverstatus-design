{
  "name": "ServerStatus Design",
  "short": "ServerStatusDesign",
  "description": "采用 shadcn/ui 现代设计规范的 ServerStatus 监控主题",
  "version": "0.0.2",
  "author": "tom2almighty",
  "url": "https://github.com/tom2almighty/komari-serverstatus-design",
  "preview": "preview.png",
  "configuration": {
    "type": "managed",
    "name": {
      "zh-CN": "ServerStatus Design 设置",
      "en": "ServerStatus Design Settings"
    },
    "data": [
      {
        "key": "rpcTransport",
        "name": {
          "zh-CN": "监控通信方式",
          "en": "Monitoring Transport"
        },
        "type": "select",
        "options": "WebSocket,HTTP",
        "default": "WebSocket",
        "help": "WebSocket 为默认实时通信方式，断线时自动以 HTTP 轮询保底；HTTP 模式不会建立 WebSocket。"
      },
      {
        "key": "max_width",
        "name": {
          "zh-CN": "页面最大宽度 (px)",
          "en": "Page Max Width (px)"
        },
        "type": "number",
        "default": 1200,
        "help": "内容区最大宽度，单位像素，推荐 1024 - 1440；越宽表格显示的列越多，越窄越紧凑"
      },
      {
        "name": {
          "zh-CN": "公告内容",
          "en": "Notice & Content"
        },
        "type": "title"
      },
      {
        "key": "announcement",
        "name": {
          "zh-CN": "站点公告",
          "en": "Announcement"
        },
        "type": "richtext",
        "default": "",
        "help": "显示在首页顶部的提示公告，支持文字"
      }
    ]
  }
}
